# =========================
# Postgres
# =========================
PGDATABASE=litellm
PGUSER=litellm
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_PORT_LOCAL=5432

# Vollständige DB-URL für LiteLLM
DATABASE_URL=postgresql://litellm:CHANGE_ME_STRONG_PASSWORD@postgres:5432/litellm

# =========================
# LiteLLM
# =========================
LITELLM_TAG=main-latest
LITELLM_MASTER_KEY=CHANGE_ME_SUPER_SECRET_MASTER_KEY

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =========================
# Open WebUI
# =========================
OPENWEBUI_TAG=main

# Öffentliche URL von OpenWebUI
WEBUI_URL=http://htl-leonding.novedu

# Muss stabil und geheim sein
WEBUI_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# Interne Verbindung von OpenWebUI zu LiteLLM
OPENAI_API_BASE_URL=http://litellm:4000/v1

# =========================
# Microsoft OAuth / OpenID
# =========================
OPENID_PROVIDER_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
MICROSOFT_OAUTH_SCOPE=openid email profile offline_access

# =========================
# pgAdmin
# =========================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PGADMIN_PORT_LOCAL=5050