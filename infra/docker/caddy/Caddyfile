# Hostnames under private / non-public TLDs cannot use Let's Encrypt.
# tls internal = HTTPS with Caddy's local CA (browser warning until CA is trusted).
#
# localhost / 127.0.0.1: Open WebUI ohne hosts-Datei (z. B. SSH: -L 8443:127.0.0.1:443 → https://127.0.0.1:8443)
# :8444: LiteLLM gleicher Zugriff (z. B. SSH: -L 8444:127.0.0.1:8444 → https://127.0.0.1:8444)

# intern / lokal
localhost, 127.0.0.1 {
	tls internal
	reverse_proxy openwebui:8080
}

:8444 {
	tls internal
	reverse_proxy litellm:4000
}

# öffentlich
ki-tutor.htl-leonding.ac.at {
	reverse_proxy openwebui:8080
}

litellm.ki-tutor.htl-leonding.ac.at {
	reverse_proxy litellm:4000
}
