# Novedu application environment
# Copy this file to .env.local for local development.

# Auth.js / Microsoft Entra ID
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_MICROSOFT_ENTRA_ID_ID="00000000-0000-0000-0000-000000000000"
AUTH_MICROSOFT_ENTRA_ID_SECRET="replace-with-entra-client-secret-value"
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="00000000-0000-0000-0000-000000000000"
# Supported aliases from the chat MVP; use either these or AUTH_MICROSOFT_*.
# AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# AZURE_CLIENT_SECRET="replace-with-entra-client-secret-value"
# AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Auth.js public app URL
# Local development:
NEXTAUTH_URL="http://localhost:3000"
# Production example:
# NEXTAUTH_URL="https://novedu.example.org"

# Signed tutor share links
# Must match the secret used to generate tutor share links.
SHARE_LINK_SECRET="replace-with-a-long-random-share-link-secret"

# Self-hosted OpenAI-compatible model endpoint
# Leave empty in CI/mock-only development.
SCCH_BASE_URL=""
SCCH_API_KEY=""

# Optional local test video hold.
# Increase when Playwright videos in test-results are too short.
E2E_VIDEO_HOLD_MS="2000"

# GitHub tutor catalog
# Tutor YAML files are loaded from this repo/folder instead of application/tutors.
# Public repos work without a token. For private repos, set TUTOR_CONFIG_GITHUB_TOKEN locally/in deployment secrets.
# Example layout: https://github.com/<owner>/<repo>/tree/main/AI/*.yaml
TUTOR_CONFIG_GITHUB_OWNER=""
TUTOR_CONFIG_GITHUB_REPO=""
TUTOR_CONFIG_GITHUB_PATH="AI"
TUTOR_CONFIG_GITHUB_REF="main"
TUTOR_CONFIG_GITHUB_TOKEN=""