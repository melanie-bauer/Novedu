@startuml Novedu ERD

entity "User" as user {
  user_id : UUID <<PK>>
  --
  entra_oid : VARCHAR(36)
  email : VARCHAR(255)
  display_name : VARCHAR(255)
  first_name : VARCHAR(100)
  last_name : VARCHAR(100)
  is_active : BOOLEAN
  last_login_at : TIMESTAMP
  role_id : UUID <<FK>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}


entity "Role" as role {
  role_id : UUID <<PK>>
  --
  name : VARCHAR(50)
  description : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Permission" as permission {
  permission_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  description : TEXT
  resource : VARCHAR(100)
  action : VARCHAR(50)
  created_at : TIMESTAMP
}
entity "RolePermission" as role_permission {
  role_permission_id : UUID <<PK>>
  --
  role_id : UUID <<FK>>
  permission_id : UUID <<FK>>
  created_at : TIMESTAMP
}

entity "Class" as class {
  class_id : UUID <<PK>>
  --
  name : VARCHAR(50)
  school_year : VARCHAR(10)
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "UserClass" as user_class {
  user_class_id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  class_id : UUID <<FK>>
}

entity "Subject" as subject {
  subject_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  description : TEXT
}

entity "LLMModel" as llm_model {
  llm_model_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  provider : VARCHAR(30)
  model_identifier : VARCHAR(100)
  is_active : BOOLEAN
  cost_per_input_token : DECIMAL(10,8)
  cost_per_output_token : DECIMAL(10,8)
}

entity "AITutor" as ai_tutor {
  ai_tutor_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  system_prompt : TEXT
  llm_model_id : UUID <<FK>>
  subject_id : UUID <<FK>>
  created_by_user_id : UUID <<FK>>
  is_active : BOOLEAN
}

entity "TutorClass" as tutor_class {
  tutor_class_assignment_id : UUID <<PK>>
  --
  tutor_id : UUID <<FK>>
  class_id : UUID <<FK>>
  is_enabled : BOOLEAN
  enabled_at : TIMESTAMP
}



user }o--|| role
user_class }o--|| user
user_class }o--|| class
role_permission }o--|| role
role_permission }o--|| permission

ai_tutor }o--|| llm_model
ai_tutor }o--|| subject
ai_tutor }o--|| user
tutor_class }o--|| ai_tutor
tutor_class }o--|| class
tutor_class }o--|| user

@enduml

