@startuml Novedu ERD
!theme plain
title Novedu – Entity Relationship Diagram

skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam roundcorner 5

!define primary_key(x) <b><color:#b8861b><&key></color> x</b>
!define foreign_key(x) <color:#aaaaaa><&key></color> x
!define column(x) <color:#262626><&media-record></color> x
!define table(x) entity x << (T, white) >>

' ========== Schule & Entra ID ==========

table(School) {
  primary_key(id) : int
  --
  column(name) : varchar(255)
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(SchoolEntraConfig) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  --
  column(tenant_id) : uuid
  column(client_id) : uuid
  column(client_secret_encrypted) : varchar(1024)
  column(redirect_uri) : varchar(1024)
  column(is_enabled) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== Nutzer ==========

table(User) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  foreign_key(budget_config_id) : int
  foreign_key(role_id) : int
  --
  column(entra_oid) : varchar(36)
  column(name) : varchar(255)
  column(email) : citext
  column(is_first_login) : boolean
  column(is_active) : boolean
  column(last_login_at) : timestamptz
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(UserSettings) {
  primary_key(id) : int
  --
  foreign_key(user_id) : int
  --
  column(language) : varchar(10)
  column(notify_budget_warning) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(BudgetUsageHistory) {
  primary_key(id) : int
  --
  foreign_key(user_id) : int
  --
  column(budget_period) : ENUM('daily', 'weekly', 'monthly', 'yearly')
  column(start_date) : date
  column(end_date) : date
  column(created_at) : timestamptz
}

' ========== Gruppen (inkl. Klassen) ==========
' Frontend: immer "Klasse" / Class; DB: Group + GroupType (Klasse, Freifachgruppe, …)

table(GroupType) {
  primary_key(id) : int
  --
  column(code) : varchar(100)
  column(name) : varchar(255)
  column(created_at) : timestamptz
}

table(Group) {
  primary_key(id) : int
  --
  foreign_key(group_type_id) : int
  foreign_key(school_id) : int
  foreign_key(budget_config_id) : int
  --
  column(name) : varchar(255)
  column(description) : text
  column(is_active) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(GroupMember) {
  primary_key(id) : int
  --
  foreign_key(group_id) : int
  foreign_key(user_id) : int
  --
  column(created_at) : timestamptz
}

' ========== Rollen & Rechte ==========

table(Role) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  foreign_key(budget_config_id) : int
  --
  column(name) : varchar(255)
  column(description) : text
  column(is_system) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== Fächer ==========

entity "Subject" as Subject {
  * id : int <<PK>>
  --
  name : varchar(255)
  school_id : int <<FK>>
  created_at : timestamptz
  updated_at : timestamptz
}

' ========== KI-Infrastruktur ==========

entity "AIProvider" as AIProvider {
  * id : int <<PK>>
  --
  name : varchar(255)
  api_key_configured : boolean
  is_enabled : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

entity "AIModel" as AIModel {
  * id : int <<PK>>
  --
  provider_id : int <<FK>>
  name : varchar(255)
  description : text
  cost_per_1k_input_tokens : numeric(10,6)
  cost_per_1k_output_tokens : numeric(10,6)
  max_input_tokens : int
  max_output_tokens : int
  is_enabled : boolean
  created_at : timestamptz
  updated_at : timestamptz
}

' ========== Tutoren ==========

entity "TutorConfig" as TutorConfig {
  * id : int <<PK>>
  --
  name : varchar(255)
  subject_id : int <<FK>>
  description : text
  system_prompt : text
  model_id : int <<FK>>
  temperature : double precision
  max_output_tokens : int
  created_by : int <<FK>>
  is_enabled : boolean
  status : enum (draft|published)
  icon : varchar(100)
  color : varchar(20)
  didactic_mode : enum
  no_personal_data : boolean
  no_full_solutions : boolean
  show_sources : boolean
  hide_knowledge_base : boolean
  expires_at : timestamptz
  assignment_text : text
  created_at : timestamptz
  updated_at : timestamptz
}

entity "TutorGroupAssignment" as TutorGroupAssignment {
  * id : int <<PK>>
  --
  tutor_id : int <<FK>>
  group_id : int <<FK>>
  is_enabled : boolean
  enabled_until : timestamptz
  created_at : timestamptz
  updated_at : timestamptz
}

entity "TutorStudentAssignment" as TutorStudentAssignment {
  * id : int <<PK>>
  --
  tutor_id : int <<FK>>
  user_id : int <<FK>>
  created_at : timestamptz
}

entity "TutorDocument" as TutorDocument {
  * id : int <<PK>>
  --
  tutor_id : int <<FK>>
  kind : enum (knowledge|assignment)
  name : varchar(255)
  type : varchar(100)
  size : bigint
  uploaded_at : timestamptz
  location : varchar(1024)
  created_at : timestamptz
  updated_at : timestamptz
}

' ========== Chat ==========

entity "Chat" as Chat {
  * id : int <<PK>>
  --
  user_id : int <<FK>>
  tutor_id : int <<FK>>
  title : varchar(255)
  date : date
  created_at : timestamptz
  updated_at : timestamptz
}

entity "Message" as Message {
  * id : int <<PK>>
  --
  chat_id : int <<FK>>
  role : enum (user|assistant)
  content : text
  feedback : enum (positive|negative)
  created_at : timestamptz
  updated_at : timestamptz
}

entity "ChatAttachment" as ChatAttachment {
  * id : int <<PK>>
  --
  message_id : int <<FK>>
  name : varchar(255)
  type : varchar(100)
  size : bigint
  uploaded_at : timestamptz
  storage_path : varchar(1024)
  created_at : timestamptz
}

' ========== Budget & Kosten ==========

entity "BudgetConfig" as BudgetConfig {
  * id : int <<PK>>
  --
  type : enum (role|group|user)
  budget_period : enum (daily|weekly|monthly|yearly)
  limit_amount : numeric(12,2)
  warning_threshold : smallint
  created_at : timestamptz
  updated_at : timestamptz
}

entity "CostEntry" as CostEntry {
  * id : int <<PK>>
  --
  message_id : int <<FK>>
  budget_usage_history_id : int <<FK>>
  tutor_id : int <<FK>>
  input_tokens : int
  output_tokens : int
  cost : numeric(12,2)
  created_at : timestamptz
}

' ========== Global ==========

entity "GlobalSettings" as GlobalSettings {
  * id : int <<PK>>
  --
  school_id : int <<FK>>
  system_prompt : text
  last_modified_by : int <<FK>>
  last_modified_at : timestamptz
  created_at : timestamptz
  updated_at : timestamptz
}

' ========== Beziehungen ==========

' Schule & Entra & GlobalSettings
School ||--|| SchoolEntraConfig : ""
School ||--|| GlobalSettings : "school_id"
School ||--o{ User : "school_id"
School ||--o{ Group : "school_id"
School ||--o{ Role : "school_id"
School ||--o{ Subject : "school_id"

' Nutzer & Budget-Historie
User ||--|| UserSettings : ""
User ||--o{ BudgetUsageHistory : "user_id"

' Gruppen (Group = Class im Frontend)
GroupType ||--o{ Group : "group_type_id"
Group ||--o{ GroupMember : ""
User ||--o{ GroupMember : ""

' Rollen & Rechte
Role ||--o{ User

' Fächer & KI & Tutoren
Subject ||--o{ TutorConfig : "subject_id"
AIProvider ||--|{ AIModel : "provider_id"
User ||--o{ TutorConfig : "created_by"
AIModel ||--o{ TutorConfig : "model_id"
TutorConfig ||--o{ TutorGroupAssignment : ""
Group ||--o{ TutorGroupAssignment : ""
TutorConfig ||--o{ TutorStudentAssignment : ""
User ||--o{ TutorStudentAssignment : ""
TutorConfig ||--o{ TutorDocument : "tutor_id"

' Chat
User ||--o{ Chat : "user_id"
TutorConfig ||--o{ Chat : "tutor_id"
Chat ||--|{ Message : "chat_id"
Message ||--o{ ChatAttachment : "message_id"

' BudgetConfig: User, Group, Role richten jeweils (optional) ein Budget ein
User }o--|| BudgetConfig : "budget_config_id"
Group }o--|| BudgetConfig : "budget_config_id"
Role }o--|| BudgetConfig : "budget_config_id"
BudgetUsageHistory ||--o{ CostEntry : "budget_usage_history_id"
CostEntry }o--|| Message: "message_id"
TutorConfig ||--o{ CostEntry : "tutor_id"
GlobalSettings }o--|| User : "last_modified_by"

@enduml
