@startuml Novedu ERD
!theme plain
title Novedu – Entity Relationship Diagram

skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam roundcorner 5

!define primary_key(x) <b><color:#b8861b><&key></color> x</b>
!define foreign_key(x) <color:#aaaaaa><&key></color> x
!define column(x) <color:#262626><&media-record></color> x
!define table(x) entity x << (T, white) >>

' ========== Schule & Entra ID ==========

table(School) {
  primary_key(id) : int
  --
  column(name) : varchar(255)
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(SchoolEntraConfig) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  --
  column(tenant_id) : uuid
  column(client_id) : uuid
  column(client_secret_encrypted) : varchar(1024)
  column(redirect_uri) : varchar(1024)
  column(is_enabled) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== Nutzer ==========

table(User) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  foreign_key(budget_config_id) : int
  foreign_key(role_id) : int
  --
  column(entra_oid) : varchar(36)
  column(name) : varchar(255)
  column(email) : citext
  column(is_first_login) : boolean
  column(is_active) : boolean
  column(last_login_at) : timestamptz
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(UserSettings) {
  primary_key(id) : int
  --
  foreign_key(user_id) : int
  --
  column(language) : varchar(10)
  column(notify_budget_warning) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(BudgetUsageHistory) {
  primary_key(id) : int
  --
  foreign_key(user_id) : int
  --
  column(budget_period) : ENUM('daily', 'weekly', 'monthly', 'yearly')
  column(start_date) : date
  column(end_date) : date
  column(created_at) : timestamptz
}

' ========== Gruppen (inkl. Klassen) ==========
' Frontend: immer "Klasse" / Class; DB: Group + GroupType (Klasse, Freifachgruppe, …)

table(GroupType) {
  primary_key(id) : int
  --
  column(code) : varchar(100)
  column(name) : varchar(255)
  column(created_at) : timestamptz
}

table(Group) {
  primary_key(id) : int
  --
  foreign_key(group_type_id) : int
  foreign_key(school_id) : int
  foreign_key(budget_config_id) : int
  --
  column(name) : varchar(255)
  column(description) : text
  column(is_active) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(GroupMember) {
  primary_key(id) : int
  --
  foreign_key(group_id) : int
  foreign_key(user_id) : int
  --
  column(created_at) : timestamptz
}

' ========== Rollen & Rechte ==========

table(Role) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  foreign_key(budget_config_id) : int
  --
  column(name) : varchar(255)
  column(description) : text
  column(is_system) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== Fächer ==========

table(Subject) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  --
  column(name) : varchar(255)
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== KI-Infrastruktur ==========

table(AIProvider) {
  primary_key(id) : int
  --
  column(name) : varchar(255)
  column(api_key_configured) : boolean
  column(is_enabled) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(AIModel) {
  primary_key(id) : int
  --
  foreign_key(provider_id) : int
  --
  column(name) : varchar(255)
  column(description) : text
  column(cost_per_1k_input_tokens) : numeric(10,6)
  column(cost_per_1k_output_tokens) : numeric(10,6)
  column(max_input_tokens) : int
  column(max_output_tokens) : int
  column(is_enabled) : boolean
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== Tutoren ==========

table(TutorConfig) {
  primary_key(id) : int
  --
  foreign_key(subject_id) : int
  foreign_key(model_id) : int
  foreign_key(created_by) : int
  --
  column(name) : varchar(255)
  column(description) : text
  column(system_prompt) : text
  column(temperature) : double precision
  column(max_output_tokens) : int
  column(is_enabled) : boolean
  column(status) : ENUM('draft', 'published')
  column(icon) : varchar(100)
  column(color) : varchar(20)
  column(didactic_mode) : enum
  column(no_personal_data) : boolean
  column(no_full_solutions) : boolean
  column(show_sources) : boolean
  column(hide_knowledge_base) : boolean
  column(expires_at) : timestamptz
  column(assignment_text) : text
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(TutorGroupAssignment) {
  primary_key(id) : int
  --
  foreign_key(tutor_id) : int
  foreign_key(group_id) : int
  --
  column(is_enabled) : boolean
  column(enabled_until) : timestamptz
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(TutorStudentAssignment) {
  primary_key(id) : int
  --
  foreign_key(tutor_id) : int
  foreign_key(user_id) : int
  --
  column(created_at) : timestamptz
}

table(TutorDocument) {
  primary_key(id) : int
  --
  foreign_key(tutor_id) : int
  --
  column(kind) : ENUM('knowledge', 'assignment')
  column(name) : varchar(255)
  column(type) : varchar(100)
  column(size) : bigint
  column(uploaded_at) : timestamptz
  column(location) : varchar(1024)
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

' ========== Chat ==========

table(Chat) {
  primary_key(id) : int
  --
  foreign_key(user_id) : int
  foreign_key(tutor_id) : int
  --
  column(title) : varchar(255)
  column(date) : date
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(Message) {
  primary_key(id) : int
  --
  foreign_key(chat_id) : int
  --
  column(role) : ENUM('user', 'assistant')
  column(content) : text
  column(feedback) : ENUM('positive', 'negative')
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(ChatAttachment) {
  primary_key(id) : int
  --
  foreign_key(message_id) : int
  --
  column(name) : varchar(255)
  column(type) : varchar(100)
  column(size) : bigint
  column(uploaded_at) : timestamptz
  column(storage_path) : varchar(1024)
  column(created_at) : timestamptz
}

' ========== Budget & Kosten ==========

table(BudgetConfig) {
  primary_key(id) : int
  --
  column(type) : ENUM('role', 'group', 'user')
  column(budget_period) : ENUM('daily', 'weekly', 'monthly', 'yearly')
  column(limit_amount) : numeric(12,2)
  column(warning_threshold) : smallint
  column(created_at) : timestamptz
  column(updated_at) : timestamptz
}

table(CostEntry) {
  primary_key(id) : int
  --
  foreign_key(message_id) : int
  foreign_key(budget_usage_history_id) : int
  foreign_key(tutor_id) : int
  --
  column(input_tokens) : int
  column(output_tokens) : int
  column(cost) : numeric(12,2)
  column(created_at) : timestamptz
}

' ========== Global ==========

table(GlobalSettings) {
  primary_key(id) : int
  --
  foreign_key(school_id) : int
  foreign_key(last_modified_by) : int
  last_modified_at : timestamptz
  created_at : timestamptz
  updated_at : timestamptz
}

' ========== Beziehungen ==========

' Schule & Entra & GlobalSettings
School ||--|| SchoolEntraConfig : ""
School ||--|| GlobalSettings : "school_id"
School ||--o{ User : "school_id"
School ||--o{ Group : "school_id"
School ||--o{ Role : "school_id"
School ||--o{ Subject : "school_id"

' Nutzer & Budget-Historie
User ||--|| UserSettings : ""
User ||--o{ BudgetUsageHistory : "user_id"

' Gruppen (Group = Class im Frontend)
GroupType ||--o{ Group : "group_type_id"
Group ||--o{ GroupMember : ""
User ||--o{ GroupMember : ""

' Rollen & Rechte
Role ||--o{ User

' Fächer & KI & Tutoren
Subject ||--o{ TutorConfig : "subject_id"
AIProvider ||--|{ AIModel : "provider_id"
User ||--o{ TutorConfig : "created_by"
AIModel ||--o{ TutorConfig : "model_id"
TutorConfig ||--o{ TutorGroupAssignment : ""
Group ||--o{ TutorGroupAssignment : ""
TutorConfig ||--o{ TutorStudentAssignment : ""
User ||--o{ TutorStudentAssignment : ""
TutorConfig ||--o{ TutorDocument : "tutor_id"

' Chat
User ||--o{ Chat : "user_id"
TutorConfig ||--o{ Chat : "tutor_id"
Chat ||--|{ Message : "chat_id"
Message ||--o{ ChatAttachment : "message_id"

' BudgetConfig: User, Group, Role richten jeweils (optional) ein Budget ein
User }o--|| BudgetConfig : "budget_config_id"
Group }o--|| BudgetConfig : "budget_config_id"
Role }o--|| BudgetConfig : "budget_config_id"
BudgetUsageHistory ||--o{ CostEntry : "budget_usage_history_id"
CostEntry }o--|| Message: "message_id"
TutorConfig ||--o{ CostEntry : "tutor_id"
GlobalSettings }o--|| User : "last_modified_by"

@enduml
