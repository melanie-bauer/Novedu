@startuml Novedu ERD
!theme plain
title Novedu – Entity Relationship Diagram

skinparam linetype ortho
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11
skinparam roundcorner 5

' ========== Schule & Entra ID ==========

entity "School" as School {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "SchoolEntraConfig" as SchoolEntraConfig {
  * id : UUID <<PK>>
  --
  school_id : UUID <<FK>>
  tenant_id : UUID
  client_id : UUID
  client_secret_encrypted : varchar(1024)
  redirect_uri : varchar(1024)
  is_enabled : boolean
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ========== Nutzer ==========

entity "User" as User {
  * id : UUID <<PK>>
  --
  entra_oid : varchar(36)
  name : varchar(255)
  email : varchar(320)
  school_id : UUID <<FK>>
  budget_config_id : UUID <<FK>>
  is_first_login : boolean
  is_active : boolean
  last_login_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "UserSettings" as UserSettings {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  language : varchar(10)
  notify_budget_warning : boolean
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "BudgetPeriod" as BudgetPeriod {
  * id : UUID <<PK>>
  --
  code : varchar(100)
  name : varchar(255)
  created_at : TIMESTAMP
}

entity "BudgetUsageHistory" as BudgetUsageHistory {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  budget_period_id : UUID <<FK>>
  start_date : date
  end_date : date
  amount_used : decimal
  created_at : TIMESTAMP
}

' ========== Gruppen (inkl. Klassen) ==========
' Frontend: immer "Klasse" / Class; DB: Group + GroupType (Klasse, Freifachgruppe, …)

entity "GroupType" as GroupType {
  * id : UUID <<PK>>
  --
  code : varchar(100)
  name : varchar(255)
  created_at : TIMESTAMP
}

entity "Group" as Group {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  description : text
  group_type_id : UUID <<FK>>
  school_id : UUID <<FK>>
  budget_config_id : UUID <<FK>>
  is_active : boolean
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "GroupMember" as GroupMember {
  * id : UUID <<PK>>
  --
  group_id : UUID <<FK>>
  user_id : UUID <<FK>>
  created_at : TIMESTAMP
}

' ========== Rollen & Rechte ==========

entity "Role" as Role {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  description : text
  school_id : UUID <<FK>>
  budget_config_id : UUID <<FK>>
  is_system : boolean
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Permission" as Permission {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  description : text
  resource : varchar(100)
  action : varchar(100)
  created_at : TIMESTAMP
}

entity "RolePermission" as RolePermission {
  * id : UUID <<PK>>
  --
  role_id : UUID <<FK>>
  permission_id : UUID <<FK>>
  created_at : TIMESTAMP
}

entity "UserRole" as UserRole {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  role_id : UUID <<FK>>
  created_at : TIMESTAMP
}

' ========== Fächer ==========

entity "Subject" as Subject {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ========== KI-Infrastruktur ==========

entity "AIProvider" as AIProvider {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  api_key_configured : boolean
  is_enabled : boolean
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "AIModel" as AIModel {
  * id : UUID <<PK>>
  --
  provider_id : UUID <<FK>>
  name : varchar(255)
  description : text
  cost_per_1k_input_tokens : decimal
  cost_per_1k_output_tokens : decimal
  max_tokens : int
  is_enabled : boolean
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ========== Tutoren ==========

entity "TutorConfig" as TutorConfig {
  * id : UUID <<PK>>
  --
  name : varchar(255)
  subject_id : UUID <<FK>>
  description : text
  system_prompt : text
  model_id : UUID <<FK>>
  temperature : decimal
  max_tokens : int
  created_by : UUID <<FK>>
  is_enabled : boolean
  status : enum (draft|published)
  icon : varchar(100)
  color : varchar(20)
  didactic_mode : enum
  no_personal_data : boolean
  no_full_solutions : boolean
  show_sources : boolean
  hide_knowledge_base : boolean
  expires_at : TIMESTAMP
  assignment_text : text
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "TutorGroupAssignment" as TutorGroupAssignment {
  * id : UUID <<PK>>
  --
  tutor_id : UUID <<FK>>
  group_id : UUID <<FK>>
  is_enabled : boolean
  enabled_until : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "TutorStudentAssignment" as TutorStudentAssignment {
  * id : UUID <<PK>>
  --
  tutor_id : UUID <<FK>>
  user_id : UUID <<FK>>
  created_at : TIMESTAMP
}

entity "TutorDocument" as TutorDocument {
  * id : UUID <<PK>>
  --
  tutor_id : UUID <<FK>>
  kind : enum (knowledge|assignment)
  name : varchar(255)
  type : varchar(100)
  size : int
  uploaded_at : TIMESTAMP
  location : varchar(1024)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ========== Chat ==========

entity "Chat" as Chat {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  tutor_id : UUID <<FK>>
  title : varchar(255)
  date : date
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "Message" as Message {
  * id : UUID <<PK>>
  --
  chat_id : UUID <<FK>>
  role : enum (user|assistant)
  content : text
  timestamp : TIMESTAMP
  feedback : enum (positive|negative)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "ChatAttachment" as ChatAttachment {
  * id : UUID <<PK>>
  --
  message_id : UUID <<FK>>
  name : varchar(255)
  type : varchar(100)
  size : int
  uploaded_at : TIMESTAMP
  storage_path : varchar(1024)
  created_at : TIMESTAMP
}

' ========== Budget & Kosten ==========

entity "BudgetConfig" as BudgetConfig {
  * id : UUID <<PK>>
  --
  type : enum (role|group|user)
  target_id : UUID
  budget_period_id : UUID <<FK>>
  limit_amount : decimal
  warning_threshold : int
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "CostEntry" as CostEntry {
  * id : UUID <<PK>>
  --
  user_id : UUID <<FK>>
  tutor_id : UUID <<FK>>
  input_tokens : int
  output_tokens : int
  cost : decimal
  timestamp : TIMESTAMP
  created_at : TIMESTAMP
}

' ========== Global ==========

entity "GlobalSettings" as GlobalSettings {
  * id : UUID <<PK>>
  --
  school_id : UUID <<FK>>
  system_prompt : text
  last_modified_by : UUID <<FK>>
  last_modified_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' ========== Beziehungen ==========

' Schule & Entra & GlobalSettings
School ||--|| SchoolEntraConfig : ""
School ||--|| GlobalSettings : "school_id"
School ||--o{ User : "school_id"
School ||--o{ Group : "school_id"
School ||--o{ Role : "school_id"

' Nutzer & Budget-Historie
User ||--|| UserSettings : ""
User ||--o{ BudgetUsageHistory : "user_id"
BudgetPeriod ||--o{ BudgetUsageHistory : "budget_period_id"

' Gruppen (Group = Class im Frontend)
GroupType ||--o{ Group : "group_type_id"
Group ||--o{ GroupMember : ""
User ||--o{ GroupMember : ""

' Rollen & Rechte
User ||--o{ UserRole : ""
Role ||--o{ UserRole : ""
Role ||--o{ RolePermission : ""
Permission ||--o{ RolePermission : ""

' Fächer & KI & Tutoren
Subject ||--o{ TutorConfig : "subject_id"
AIProvider ||--|{ AIModel : "provider_id"
User ||--o{ TutorConfig : "created_by"
AIModel ||--o{ TutorConfig : "model_id"
TutorConfig ||--o{ TutorGroupAssignment : ""
Group ||--o{ TutorGroupAssignment : ""
TutorConfig ||--o{ TutorStudentAssignment : ""
User ||--o{ TutorStudentAssignment : ""
TutorConfig ||--o{ TutorDocument : "tutor_id"

' Chat
User ||--o{ Chat : "user_id"
TutorConfig ||--o{ Chat : "tutor_id"
Chat ||--|{ Message : "chat_id"
Message ||--o{ ChatAttachment : "message_id"

' BudgetConfig: User, Group, Role richten jeweils (optional) ein Budget ein
User }o--|| BudgetConfig : "budget_config_id"
Group }o--|| BudgetConfig : "budget_config_id"
Role }o--|| BudgetConfig : "budget_config_id"
BudgetPeriod ||--o{ BudgetConfig : "budget_period_id"
User ||--o{ CostEntry : "user_id"
TutorConfig ||--o{ CostEntry : "tutor_id"
GlobalSettings }o--|| User : "last_modified_by"

@enduml
